{
  "name": "costco-mobile",
  "version": "1.0.0",
  "author": "Everyday Labs",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "posthog-react-native": "^4.61.4",
    "posthog-react-native-session-replay": "^1.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~54.0.18",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.3.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check:contrast": "node scripts/check-contrast.js",
    "test": "jest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:coverage": "jest --coverage",
    "prepare": "cd .. && husky costco-mobile/.husky",
    "format": "prettier --write .. --ignore-path ../.prettierignore --ignore-path ../.gitignore",
    "format:check": "prettier --check .. --ignore-path ../.prettierignore --ignore-path ../.gitignore --log-level warn",
    "build:web": "EXPO_NO_DOTENV=1 EXPO_PUBLIC_SUPABASE_URL=https://visual-test.invalid EXPO_PUBLIC_SUPABASE_ANON_KEY=visual-test expo export --platform web --clear",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "clearMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/",
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "contexts/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "constants/**/*.{ts,tsx}",
      "!**/__tests__/**"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "testTimeout": 20000,
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "functions": 75,
        "branches": 65
      }
    }
  }
}
