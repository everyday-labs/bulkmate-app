{
  "expo": {
    "name": "costco-mobile",
    "slug": "costco-app",
    "scheme": "costco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.twonk0609.costco-app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#E31837",
          "iosDisplayInForeground": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Costco uses your location to verify you're at a warehouse and award check-in badges.",
          "locationWhenInUsePermission": "Costco uses your location to verify you're at a warehouse and award check-in badges."
        }
      ],
      "expo-font",
      "./plugins/withScriptSandboxDisabled"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92f28e61-30ad-4180-aa20-32e6fc88c52c"
      }
    },
    "owner": "twonk0609s-team"
  }
}
